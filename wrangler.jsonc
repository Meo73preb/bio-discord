{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bio-discord",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/*"]
  },
  "vars": {
    "ALLOWED_HOST": "meo-mate.site"
  },
  "observability": {
    "enabled": true
  }
}
